# AgriSmart AI Backend Environment Variables
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Open-Meteo or Weather API Override (Default uses open public endpoints)
WEATHER_API_TIMEOUT_SECONDS=6

# SQLite Database File Path (Default: ./agrismart.db)
DATABASE_PATH=agrismart.db
